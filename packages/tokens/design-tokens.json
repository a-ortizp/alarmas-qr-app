{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Alarmas QR · Energía puntual",
    "version": "1.5",
    "date": "2026-09-16",
    "source": "DESIGN_SYSTEM.md v1.5 · STYLE_TILE.md v1.2 · MOCKUPS.md §7",
    "figma": "https://www.figma.com/design/lHYLJJIbltBS5Joo850iks",
    "notes": [
      "Un solo elemento amarillo por pantalla: la acción principal o el FAB extendido. Los estados activos van en Tinta.",
      "Coral solo en urgencia y destrucción. Los estados nunca se comunican solo con color.",
      "Texto ≤ 15 pt usa los tonos AA (*.texto); los tonos base quedan para rellenos, íconos y trazos.",
      "Sobre Tinta el texto secundario va en Gris Borde y el primario es blanco (excepción M10).",
      "Alturas: 48 para toque en móvil, 44 para puntero en web; 56 en las acciones de la alarma sonando."
    ]
  },
  "color": {
    "amarillo": {
      "energia": { "$value": "#FFC400", "$type": "color", "$description": "Acción primaria y marca" },
      "suave":   { "$value": "#FFF1BF", "$type": "color", "$description": "Tinte y resaltado suave (bloques «Sonará»)" }
    },
    "tinta":        { "$value": "#17161C", "$type": "color", "$description": "Texto, marca, estados activos, fondos plenos (M03, M10)" },
    "blanco":       { "$value": "#FFFFFF", "$type": "color", "$description": "Blanco Papel · fondo" },
    "coral": {
      "alarma": { "$value": "#E8443A", "$type": "color", "$description": "Urgencia · alarma sonando · rellenos e íconos" },
      "texto":  { "$value": "#C4362E", "$type": "color", "$description": "Coral Texto · destructivo · 5.4:1 sobre blanco" }
    },
    "verde": {
      "confirmado": { "$value": "#129E63", "$type": "color", "$description": "Éxito · verificado · rellenos e íconos" },
      "texto":      { "$value": "#0B7048", "$type": "color", "$description": "Verde Texto · escaneada · publicado · 6.1:1" },
      "fondo":      { "$value": "#E9F7F0", "$type": "color", "$description": "Relleno de chips Publicado / Activa (web)" }
    },
    "azul": {
      "enlace": { "$value": "#2E7CF6", "$type": "color", "$description": "Informativo · íconos" },
      "texto":  { "$value": "#1A5BC4", "$type": "color", "$description": "Azul Texto · enlaces · 6.3:1" }
    },
    "gris": {
      "niebla": { "$value": "#F4F3EF", "$type": "color", "$description": "Superficies · píldora inactiva · contenedor del segmentado" },
      "medio":  { "$value": "#77747E", "$type": "color", "$description": "Marcadores de posición · texto secundario base" },
      "texto":  { "$value": "#66636D", "$type": "color", "$description": "Gris Texto · texto secundario ≤ 15 pt · 5.9:1" },
      "borde":  { "$value": "#DAD8D2", "$type": "color", "$description": "Bordes 1.5 y divisores · texto secundario sobre Tinta" }
    },
    "velo": { "$value": "rgba(23, 22, 28, 0.45)", "$type": "color", "$description": "Velo de modal (web) · Tinta al 45 %" }
  },
  "font": {
    "family": {
      "titulares": { "$value": "Bricolage Grotesque", "$type": "fontFamily", "$description": "Google Fonts · OFL · pesos 600 y 700" },
      "ui":        { "$value": "Archivo", "$type": "fontFamily", "$description": "Google Fonts · OFL · 400, 500, 600, 700" },
      "datos":     { "$value": "Spline Sans Mono", "$type": "fontFamily", "$description": "Google Fonts · OFL · 500 y 700 · horas y cifras, dígitos tabulares" }
    },
    "scale": {
      "hora-protagonista": { "family": "datos", "weight": 700, "size": 96, "$description": "M10 alarma sonando; sufijo pm 28" },
      "hora-sonara":       { "family": "datos", "weight": 700, "size": 52, "$description": "Bloques «Sonará» M04 / M09; etiqueta 12 encima" },
      "hora-tarjeta":      { "family": "datos", "weight": 700, "size": 26, "$description": "Tarjeta de alarma (26–28) + am/pm Medium 12–14 en línea" },
      "hora-ampm":         { "family": "datos", "weight": 500, "size": 12 },
      "indicador-web":     { "family": "datos", "weight": 700, "size": 24, "$description": "Número de la tarjeta de estadística web" },
      "h1":                { "family": "titulares", "weight": 700, "size": 28, "$description": "Nombre de pantalla (móvil)" },
      "h1-web":            { "family": "titulares", "weight": 700, "size": 24, "$description": "Título de página web" },
      "barra-superior":    { "family": "titulares", "weight": 700, "size": 22 },
      "h2":                { "family": "titulares", "weight": 600, "size": 22, "$description": "Sección · nombre de evento (20–22)" },
      "titulo-modal-web":  { "family": "titulares", "weight": 700, "size": 21 },
      "marca-web":         { "family": "titulares", "weight": 700, "size": 17 },
      "destacado":         { "family": "ui", "weight": 700, "size": 16 },
      "cuerpo":            { "family": "ui", "weight": 400, "size": 16 },
      "boton-movil":       { "family": "ui", "weight": 700, "size": 15 },
      "titulo-tarjeta":    { "family": "ui", "weight": 700, "size": 15 },
      "boton-web":         { "family": "ui", "weight": 600, "size": 14.5, "$description": "14–15 según contexto" },
      "nav-lateral":       { "family": "ui", "weight": 600, "size": 14.5 },
      "tabla-celda":       { "family": "ui", "weight": 400, "size": 14 },
      "h3":                { "family": "ui", "weight": 700, "size": 13, "transform": "uppercase", "letterSpacing": "8%", "$description": "Agrupadores «HOY · JUEVES 27»" },
      "etiqueta":          { "family": "ui", "weight": 400, "size": 13, "$description": "«evento 8:00 am · Aula SD-703»" },
      "pildora-web":       { "family": "ui", "weight": 600, "size": 13 },
      "nota":              { "family": "ui", "weight": 400, "size": 12.5 },
      "chip":              { "family": "ui", "weight": 700, "size": 12 },
      "rotulo-tabla":      { "family": "ui", "weight": 700, "size": 11, "transform": "uppercase", "letterSpacing": "6%", "$description": "Encabezados de tabla y etiquetas de campo web; mínimo del sistema" },
      "nav-inferior":      { "family": "ui", "weight": 400, "size": 11, "$description": "Única excepción por debajo de 12" }
    }
  },
  "size": {
    "boton": { "movil": 48, "web": 44, "alarma": 56, "$description": "Alturas de botón: toque / puntero / acciones de la alarma sonando" },
    "campo": 48,
    "fab": 56,
    "barra-superior-movil": 56,
    "navegacion-inferior": 64,
    "barra-superior-web": 64,
    "barra-lateral-web": 208,
    "item-barra-lateral": 38,
    "pildora-filtro": 34,
    "segmentado-web": 36,
    "chip": 20,
    "snackbar-web": 36,
    "tabla-encabezado": 26,
    "tabla-fila": 48,
    "indicador-web": { "width": 242, "height": 104 },
    "modal-web": { "min": 540, "max": 600 },
    "tarjeta-acceso": 400,
    "switch": { "width": 42, "height": 24 },
    "area-tactil-minima": 48,
    "banda-textura": 120,
    "qr-afiche-minimo-cm": 4
  },
  "radius": {
    "pildora": 999,
    "tarjeta": 14,
    "modal": 14,
    "campo": 12,
    "chip-web": 8,
    "barra": 4,
    "$description": "Radio 14 en tarjetas, modales y contenedores; 12 en campos; píldora en botones, chips y filtros"
  },
  "stroke": {
    "borde": 1.5,
    "borde-fino": 1,
    "foco": 2,
    "marco-pantalla": 3
  },
  "space": {
    "movil": { "margen": 20, "medianil": 12, "columnas": 4, "entre-bloques": 12 },
    "web": { "contenido-vertical": 28, "contenido-horizontal": 32, "entre-bloques": 18, "lateral-topbar": 28, "barra-lateral": [20, 12], "modal": 24, "entre-indicadores": 14 },
    "boton-web-padding": [13, 18],
    "pildora-padding": [10, 14],
    "chip-padding": [3, 12]
  },
  "motion": {
    "transicion": { "duration": 250, "easing": "ease-in-out", "$description": "Smart Animate 250 ms en todas las conexiones del prototipo" },
    "deshacer": { "duration": 5000, "$description": "Ventana del snackbar «Deshacer»" },
    "toque-largo": { "duration": 500, "$description": "Mantener presionado el FAB para abrir la hoja «Agregar evento»" }
  },
  "elevation": {
    "fab": "0 4px 12px rgba(23, 22, 28, 0.18)",
    "tarjeta-evento": "0 6px 18px rgba(23, 22, 28, 0.10)"
  },
  "texture": {
    "modulos-qr": { "opacityMax": 0.08, "band": 120, "screens": ["M01", "M04", "M09", "M10", "M12", "M13"], "$description": "Retícula de módulos QR que se desvanece hacia abajo; nunca en listas, formularios ni visor" }
  }
}
